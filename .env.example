PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
DB_NAME=fixmate

# Signs and verifies the API tokens. Must be the SAME value as JWT_SECRET in fixmate-client
JWT_SECRET=your_long_random_secret

# Stripe test keys (Stripe Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (Stripe Dashboard -> Developers -> Webhooks ->
# your endpoint -> Signing secret). Must start with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Frontend URL, used for CORS and the Stripe success/cancel pages.
# Local: http://localhost:3000   |   Vercel: https://your-client.vercel.app
CLIENT_URL=http://localhost:3000
